# Copy this file to .env for local Docker Compose.
# Do not commit real credentials.

# LLM
GEMINI_API_KEY=
GOOGLE_API_KEY=

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/
MONGO_DB_NAME=jobs_hunter
MONGO_CONNECT_RETRIES=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=12000

# Elastic Cloud
ELASTIC_URL=https://YOUR-ELASTIC-ENDPOINT:443
ELASTIC_API_KEY=
ELASTIC_CLOUD_ID=
ELASTIC_INDEX_NAME=job_descriptions
ELASTIC_EPISODE_INDEX_NAME=application_episodes

# Arize Phoenix
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/YOUR_SPACE/v1/traces
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=job-hunter-agent

# Gmail / email
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_USERNAME=
EMAIL_PASSWORD=
ALLOW_LOCAL_GMAIL_TOKEN=false

# Demo controls
DEMO_LOCKED_EMAIL=demo@example.com
DEMO_EMAIL_OAUTH_LOCKED=true
PLAYWRIGHT_HEADLESS=true
