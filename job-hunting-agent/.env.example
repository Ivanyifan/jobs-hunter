# Copy this file to .env for local Docker Compose.
# Do not commit real credentials.

# LLM
GEMINI_API_KEY=
GOOGLE_API_KEY=

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/
MONGO_DB_NAME=jobs_hunter
MONGO_CONNECT_RETRIES=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=12000

# Elastic Cloud
ELASTIC_URL=https://YOUR-ELASTIC-ENDPOINT:443
ELASTIC_API_KEY=
ELASTIC_CLOUD_ID=
ELASTIC_INDEX_NAME=job_descriptions
ELASTIC_EPISODE_INDEX_NAME=application_episodes

# Arize Phoenix
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/YOUR_SPACE/v1/traces
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=job-hunter-agent

# Gmail / email
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_CLIENT_SECRET_PATH=
GMAIL_OAUTH_TOKEN_PATH=
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_USERNAME=
EMAIL_PASSWORD=
ALLOW_LOCAL_GMAIL_TOKEN=false

# Demo controls
DEMO_LOCKED_EMAIL=demo@example.com
DEMO_EMAIL_OAUTH_LOCKED=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_USE_PERSISTENT_PROFILE=false
PLAYWRIGHT_PROFILE_ROOT=./data/browser_profiles
WORKDAY_AUTH_SUBMIT_TIMEOUT_MS=40000
WORKDAY_STAGE_CONTROLLER_PIPELINE=true
WORKDAY_LIVE_SMOKE_ALLOW_VISUAL_FALLBACK=0
WORKDAY_LIVE_SMOKE_ALLOW_VISUAL_FIELD_FALLBACK=0
WORKDAY_LIVE_SMOKE_ALLOW_RESUME_UPLOAD=0
WORKDAY_LIVE_SMOKE_ALLOW_EMAIL_VERIFICATION=0
WORKDAY_LIVE_SMOKE_EMAIL_VERIFICATION_TIMEOUT_SECONDS=120
WORKDAY_LIVE_SMOKE_EMAIL_OVERRIDE=
WORKDAY_LLM_PLAN_MIN_CONFIDENCE=0.75
